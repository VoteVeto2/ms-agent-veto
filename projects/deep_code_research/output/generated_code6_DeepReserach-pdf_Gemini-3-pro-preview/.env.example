```bash
# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Primary: OpenRouter API (Access to Anthropic Claude 3.5 Haiku, etc.)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: OpenAI API Key (if using OpenAI models directly)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model Selection
# Recommended: anthropic/claude-3.5-haiku
LLM_MODEL=anthropic/claude-3.5-haiku

# -----------------------------------------------------------------------------
# Search Service Configuration
# -----------------------------------------------------------------------------
# Primary: SerpApi (Google Search)
# Get key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=...

# Optional: Tavily API (Alternative search provider)
# Get key: https://tavily.com/
TAVILY_API_KEY=tvly-...

# -----------------------------------------------------------------------------
# Content Parsing & Extraction Service
# -----------------------------------------------------------------------------
# Primary: Jina Reader API (Web scraping and parsing)
# Get key: https://jina.ai/reader
JINA_API_KEY=jina_...

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Maximum number of research iterations (loops)
MAX_ITERATIONS=3

# Number of search queries to generate per iteration
SEARCH_QUERY_COUNT=4
```